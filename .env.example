# Discord MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Discord account token (use at your own risk - self-bots violate ToS)
DISCORD_TOKEN=your_discord_token_here

# Optional: Gemini API key for AI-based hCaptcha solving (required for captcha solver)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Proxy for hCaptcha solving (format: user:pass@ip:port or ip:port)
CAPTCHA_PROXY=

# Optional: custom path to discrawl binary (default: `discrawl` from PATH)
DISCRAWL_BIN=

# ===========================================
# Rate Limiting Configuration
# ===========================================
# Enabled by default to reduce accidental Discord rate-limit hits
RATE_LIMIT_ENABLED=true

# Maximum messages per minute
RATE_LIMIT_MESSAGES_PER_MINUTE=10

# Maximum messages per second
RATE_LIMIT_MESSAGES_PER_SECOND=1

# Maximum actions (joins, leaves, etc.) per minute
RATE_LIMIT_ACTIONS_PER_MINUTE=5

# Cooldown duration in seconds when rate limit is hit
RATE_LIMIT_COOLDOWN=60

# ===========================================
# Outgoing file attachments
# ===========================================
# Maximum size in bytes of a single file passed to send_message / send_thread_message.
# The default is deliberately conservative; Discord's real per-file ceiling depends on
# your Nitro tier and the target server's boost level.
MAX_UPLOAD_BYTES=8388608

# Maximum combined size in bytes of all files on one message. Discord caps the Create
# Message request at 25 MiB including multipart overhead, so leave some headroom.
MAX_UPLOAD_TOTAL_BYTES=20971520

# Required to allow outgoing file attachments. Lists fully qualified directories uploads may
# read from, separated by ':' on POSIX or ';' on Windows. Anyone who can call
# send_message could otherwise publish any file the server process can read, so
# there is no value that means "anything". Unset, blank, or a path that does not
# exist all refuse every upload; plain text sends are unaffected.
# UPLOAD_DIRS=/tmp/uploads:/srv/reports

# ===========================================
# Temp directory for hCaptcha solver
# ===========================================
TEMP_DIR=/tmp/hcaptcha
